# =============================================================================================
# ResQ AI backend - local development settings (FastAPI)
#
#   cp .env.example .env
#   uvicorn app.main:app --reload
#
# Read from backend/.env (the current directory) and the process environment; environment
# variables win. Empty values mean "not configured": the matching feature is disabled or
# falls back gracefully. With Docker, use the root .env.example instead.
#
# Generate secrets with:  openssl rand -base64 48   (or: make secrets)
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------

# development | production | test
APP_ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# true = one JSON object per log line, false = human-readable lines.
LOG_JSON=false

# Comma-separated browser origins allowed by CORS (the web app normally uses its proxy).
CORS_ORIGINS=http://localhost:3000

# SQLAlchemy async URL. The parent directory of a SQLite file is created automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/resq.db


# ---------------------------------------------------------------------------------------------
# Auth - must match frontend/.env.local
# ---------------------------------------------------------------------------------------------

# HS256 secret shared with the Next.js proxy (verifies the 5-minute user tokens).
# Empty = endpoints that require sign-in return 503 not_configured.
BACKEND_JWT_SECRET=

# Shared key for the internal /api/users/* endpoints (X-Internal-Key header).
# Empty = /api/users/* return 503 (email/password sign-in disabled).
INTERNAL_API_KEY=


# ---------------------------------------------------------------------------------------------
# AI (Google Gemini) - optional; without a key the agents use deterministic fallbacks
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ---------------------------------------------------------------------------------------------
# Weather and disaster data - optional; keyless real sources are used when empty
# ---------------------------------------------------------------------------------------------

# OpenWeatherMap key (https://openweathermap.org/api). Empty = Open-Meteo (free, keyless).
OPENWEATHER_API_KEY=

# true only if your OpenWeatherMap account includes One Call 3.0 (official weather alerts).
OPENWEATHER_ONECALL_ENABLED=false

# Approved ReliefWeb appname (request one via https://apidoc.reliefweb.int).
# Empty = news is derived from GDACS events only.
RELIEFWEB_APPNAME=


# ---------------------------------------------------------------------------------------------
# SOS SMS (Twilio) - optional; without it the SOS page opens the phone's SMS app instead
# Needs the account SID, the auth token and either a sender number or a messaging service.
# ---------------------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Sender number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Messaging Service SID (MG...), used instead of TWILIO_FROM_NUMBER when set.
TWILIO_MESSAGING_SERVICE_SID=


# ---------------------------------------------------------------------------------------------
# Web push (VAPID) - optional; both keys are required to enable push notifications
# Generate with:  npx web-push generate-vapid-keys   (or: make vapid)
# ---------------------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact for push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@example.com


# ---------------------------------------------------------------------------------------------
# Rate limiting (per signed-in user, otherwise per client IP)
# Format: "<count>/<second|minute|hour|day>", several limits separated by ";"
# ---------------------------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
SOS_RATE_LIMIT=5/minute

# Incident reports per signed-in user (POST /api/incidents).
INCIDENT_RATE_LIMIT=5/hour;20/day

# Reverse proxies directly in front of the BACKEND whose X-Forwarded-For entry is trusted.
# 0 = ignore X-Forwarded-For (anyone can forge it) and use the socket address. Browsers going
# through the Next.js proxy are identified by the X-ResQ-Client-IP header it sends together
# with INTERNAL_API_KEY, so the standard setup needs 0 here.
TRUSTED_PROXY_HOPS=0


# ---------------------------------------------------------------------------------------------
# SOS SMS budgets (independent of the caller's IP address; protect your Twilio account)
# ---------------------------------------------------------------------------------------------

# SOS text messages per destination number. Numbers over budget are not sent through Twilio;
# the app offers the phone's own SMS app for them instead.
SOS_SMS_PER_NUMBER_LIMIT=3/hour;10/day

# SOS text messages per caller (signed-in user id, else the client address with IPv6
# reduced to its /64), so one caller cannot use up the shared budgets with made-up numbers.
SOS_SMS_PER_CLIENT_LIMIT=30/hour;100/day

# SOS text messages for all anonymous callers together (counted inside the global budget), so
# signed-in users always keep the rest.
SOS_SMS_ANONYMOUS_LIMIT=200/hour;1000/day

# SOS text messages for the whole server. Numbers Twilio rejects (free) are refunded.
SOS_SMS_GLOBAL_LIMIT=500/hour;3000/day

# true = only signed-in users get SOS SMS through Twilio (anonymous users get the native SMS
# app fallback only).
SOS_SMS_REQUIRE_AUTH=false


# ---------------------------------------------------------------------------------------------
# Background GDACS alert poller (push notifications for Orange/Red disasters near subscribers)
# Without it, subscribers only get community incident pushes and the app hides the
# "Disaster alerts" topic. It only runs when web push (VAPID) is configured as well.
# ---------------------------------------------------------------------------------------------
ALERT_POLLER_ENABLED=true

# Seconds between polls (30 - 86400).
ALERT_POLL_INTERVAL_SECONDS=600


# ---------------------------------------------------------------------------------------------
# Incidents, upstream HTTP and caching
# ---------------------------------------------------------------------------------------------

# Upvotes needed before a community incident is shown as "verified".
INCIDENT_VERIFY_THRESHOLD=3

# Timeout for calls to external data providers, in seconds.
HTTP_TIMEOUT_SECONDS=10

# Cache lifetimes in seconds.
WEATHER_CACHE_TTL=300
FEED_CACHE_TTL=600
PLACES_CACHE_TTL=3600

# Overpass API endpoint for nearby places (hospitals, shelters, ...). The public instance
# allows ~2 concurrent queries per server IP; for many simultaneous users point this at a
# self-hosted or commercial instance and raise OVERPASS_MAX_CONCURRENCY to what it allows.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MAX_CONCURRENCY=2
