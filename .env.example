# =============================================================================================
# ResQ AI - configuration for `docker compose` (copy to .env next to docker-compose.yml)
#
#   cp .env.example .env
#
# docker compose reads this file twice: to fill ${VARIABLES} in docker-compose.yml (shared
# secrets, frontend settings) and as the backend's env_file (every backend setting).
# Never commit the real .env. For running the services without Docker use
# backend/.env.example and frontend/.env.example instead.
#
# Generate each secret with one of:
#   openssl rand -base64 48
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   make secrets
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Shared secrets (REQUIRED - docker compose refuses to start while any of these is empty)
# ---------------------------------------------------------------------------------------------

# Encrypts and signs NextAuth session cookies (frontend only).
NEXTAUTH_SECRET=

# HS256 secret shared by the Next.js proxy (signs 5-minute user tokens) and the backend
# (verifies them). Use at least 32 random characters.
BACKEND_JWT_SECRET=

# Shared key for the internal /api/users/* endpoints (sent as X-Internal-Key by the Next.js
# server; the browser can never reach these endpoints).
INTERNAL_API_KEY=


# ---------------------------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------------------------

# Public URL of the web app as users reach it (used by NextAuth for callbacks and redirects).
# Change it when serving on a real domain, e.g. https://resq.example.org
NEXTAUTH_URL=http://localhost:3000

# Optional GitHub OAuth app (both values needed to show "Continue with GitHub").
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Optional Google OAuth client (both values needed to show "Continue with Google").
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reverse proxies in front of Next.js whose X-Forwarded-For entry is trusted for the client
# address (rate limits, SOS SMS budgets). docker-compose.yml ships one nginx proxy that
# overwrites X-Forwarded-For with a single resolved address, hence 1 - keep 1 even with an
# HTTPS terminator / cloud load balancer in front of that nginx: list the load balancer's
# address range in deploy/nginx/trusted-proxies.conf (set_real_ip_from) instead, otherwise
# every visitor shares the load balancer's address and one rate-limit bucket.
FRONTEND_TRUSTED_PROXY_HOPS=1

# Optional fallback map centre when the user's location is unknown (decimal degrees).
# Inlined at BUILD time: rebuild the frontend image after changing. Empty = New Delhi.
NEXT_PUBLIC_DEFAULT_LAT=
NEXT_PUBLIC_DEFAULT_LON=


# ---------------------------------------------------------------------------------------------
# Backend runtime
# DATABASE_URL is fixed by docker-compose.yml (SQLite on the resq-data volume).
# ---------------------------------------------------------------------------------------------

# development | production | test
APP_ENV=production

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# true = one JSON object per log line (for log shippers), false = human-readable lines.
LOG_JSON=false

# Comma-separated origins allowed to call the API directly from a browser. The web app goes
# through its same-origin proxy, so this only matters for other browser clients.
CORS_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------------------------------
# AI (Google Gemini) - optional; without a key every agent uses its deterministic fallback
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ---------------------------------------------------------------------------------------------
# Weather and disaster data - optional; keyless real sources are used when empty
# ---------------------------------------------------------------------------------------------

# OpenWeatherMap key (https://openweathermap.org/api). Empty = Open-Meteo (free, keyless).
OPENWEATHER_API_KEY=

# true only if your OpenWeatherMap account includes One Call 3.0 (official weather alerts).
OPENWEATHER_ONECALL_ENABLED=false

# Approved ReliefWeb appname (request one via https://apidoc.reliefweb.int).
# Empty = news is derived from GDACS events only.
RELIEFWEB_APPNAME=


# ---------------------------------------------------------------------------------------------
# SOS SMS (Twilio) - optional; without it the SOS page opens the phone's SMS app instead
# Needs the account SID, the auth token and either a sender number or a messaging service.
# ---------------------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Sender number in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Messaging Service SID (MG...), used instead of TWILIO_FROM_NUMBER when set.
TWILIO_MESSAGING_SERVICE_SID=


# ---------------------------------------------------------------------------------------------
# Web push (VAPID) - optional; both keys are required to enable push notifications
# Generate with:  npx web-push generate-vapid-keys   (or: make vapid)
# ---------------------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact for push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@example.com


# ---------------------------------------------------------------------------------------------
# Rate limiting (per signed-in user, otherwise per client IP)
# Format: "<count>/<second|minute|hour|day>", several limits separated by ";"
# ---------------------------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
SOS_RATE_LIMIT=5/minute

# Incident reports per signed-in user (POST /api/incidents).
INCIDENT_RATE_LIMIT=5/hour;20/day

# Reverse proxies directly in front of the BACKEND whose X-Forwarded-For entry is trusted.
# 0 = ignore X-Forwarded-For (anyone can forge it) and use the socket address. Browsers going
# through the Next.js proxy are identified by the X-ResQ-Client-IP header it sends together
# with INTERNAL_API_KEY, so the standard setup needs 0 here.
TRUSTED_PROXY_HOPS=0


# ---------------------------------------------------------------------------------------------
# SOS SMS budgets (independent of the caller's IP address; protect your Twilio account)
# ---------------------------------------------------------------------------------------------

# SOS text messages per destination number. Numbers over budget are not sent through Twilio;
# the app offers the phone's own SMS app for them instead.
SOS_SMS_PER_NUMBER_LIMIT=3/hour;10/day

# SOS text messages per caller (signed-in user id, else the client address with IPv6
# reduced to its /64), so one caller cannot use up the shared budgets with made-up numbers.
SOS_SMS_PER_CLIENT_LIMIT=30/hour;100/day

# SOS text messages per client address (IPv6 by /64) for everyone sending from it, signed in
# or not, so many accounts created on one address share one budget. Signed-in requests only
# count here when the Next.js server reports the address (INTERNAL_API_KEY set). People behind
# one shared address (a shelter's Wi-Fi, carrier NAT) share it too; raise it if that matters
# more to you than the global budget below.
SOS_SMS_PER_ADDRESS_LIMIT=60/hour;200/day

# SOS text messages per IPv6 /48 network (all its /64 addresses together, signed in or not):
# one customer often holds a /48 or /56 and would otherwise get a fresh per-address budget for
# each of its /64 networks. Higher than the per-address budget because a /48 can also be a
# carrier pool shared by many people; one busy client can still use it up for everyone on its
# /48, whose SOS then offers the phone's own SMS app instead. IPv4 addresses have no wider
# bucket.
SOS_SMS_PER_PREFIX_LIMIT=150/hour;600/day

# SOS text messages for all anonymous callers together (counted inside the global budget), so
# anonymous traffic can never take more than this part of it.
SOS_SMS_ANONYMOUS_LIMIT=200/hour;1000/day

# SOS text messages for new callers together: anonymous callers and email/password accounts
# registered less than SOS_SMS_ESTABLISHED_ACCOUNT_HOURS ago. Counted inside the global budget
# and kept below it, so the difference (100/hour and 600/day with the defaults) stays reserved
# for established accounts: freshly registered accounts, however many, cannot use it all. Set
# it equal to SOS_SMS_GLOBAL_LIMIT to drop the reserve.
SOS_SMS_NEW_CALLER_LIMIT=400/hour;2400/day

# Account age in hours (0 to 8760) from which an email/password account counts as established
# and may use the reserved part of the global budget. OAuth sign-ins count as established (the
# provider vetted the account). 0 = every signed-in caller is established.
SOS_SMS_ESTABLISHED_ACCOUNT_HOURS=24

# SOS text messages for the whole server (the bill guard). Numbers Twilio rejects (free) are
# refunded. Established accounts spread over many addresses can still use it up; over budget
# every contact gets the phone's own SMS app instead.
SOS_SMS_GLOBAL_LIMIT=500/hour;3000/day

# true = only signed-in users get SOS SMS through Twilio (anonymous users get the native SMS
# app fallback only).
SOS_SMS_REQUIRE_AUTH=false


# ---------------------------------------------------------------------------------------------
# Background GDACS alert poller (push notifications for Orange/Red disasters near subscribers)
# Without it, subscribers only get community incident pushes and the app hides the
# "Disaster alerts" topic. It only runs when web push (VAPID) is configured as well.
# ---------------------------------------------------------------------------------------------
ALERT_POLLER_ENABLED=true

# Seconds between polls (30 - 86400).
ALERT_POLL_INTERVAL_SECONDS=600


# ---------------------------------------------------------------------------------------------
# Incidents, upstream HTTP and caching
# ---------------------------------------------------------------------------------------------

# Upvotes needed before a community incident is shown as "verified".
INCIDENT_VERIFY_THRESHOLD=3

# Timeout for calls to external data providers, in seconds.
HTTP_TIMEOUT_SECONDS=10

# Cache lifetimes in seconds.
WEATHER_CACHE_TTL=300
FEED_CACHE_TTL=600
PLACES_CACHE_TTL=3600

# Overpass API endpoint for nearby places (hospitals, shelters, ...). The public instance
# allows ~2 concurrent queries per server IP; for many simultaneous users point this at a
# self-hosted or commercial instance and raise OVERPASS_MAX_CONCURRENCY to what it allows.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MAX_CONCURRENCY=2
