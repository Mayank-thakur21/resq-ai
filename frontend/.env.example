# =============================================================================================
# ResQ AI frontend - local development settings (Next.js)
#
#   cp .env.example .env.local
#   npm run dev
#
# Everything here is read on the SERVER at runtime, except NEXT_PUBLIC_* values, which are
# inlined into the browser bundle when the app is built (restart `npm run dev` / rebuild after
# changing them). Never put secrets in NEXT_PUBLIC_* variables. With Docker, use the root
# .env.example instead.
#
# Generate secrets with:  openssl rand -base64 48   (or: make secrets)
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Backend connection
# ---------------------------------------------------------------------------------------------

# Base URL of the FastAPI backend as seen from the Next.js server (not from the browser).
# The browser only calls the same-origin proxy /api/backend/*. Default: http://localhost:8000
BACKEND_URL=http://localhost:8000


# Number of reverse proxies in front of this Next.js server whose X-Forwarded-For entry is
# trusted. The client address (used by the backend's rate limits and SOS SMS budgets) is the
# entry this many hops from the right. 0 = Next.js is reached directly: only the address
# Next.js itself records can be used, and a client can still forge X-Forwarded-For, so never
# expose Next.js to the internet with 0 - put a proxy that sets X-Forwarded-For in front
# (docker-compose.yml ships one) and set 1. Default: 0
TRUSTED_PROXY_HOPS=0


# ---------------------------------------------------------------------------------------------
# Auth (NextAuth v4)
# ---------------------------------------------------------------------------------------------

# Public URL of the web app (callbacks, redirects, absolute metadata links).
NEXTAUTH_URL=http://localhost:3000

# Encrypts and signs the session cookie. REQUIRED in production.
NEXTAUTH_SECRET=

# Must equal BACKEND_JWT_SECRET in backend/.env: signs the 5-minute tokens the proxy sends
# to the backend for signed-in users.
BACKEND_JWT_SECRET=

# Must equal INTERNAL_API_KEY in backend/.env: lets the server register and verify
# email/password users through the internal /api/users/* endpoints, and authenticates the
# client address it reports to the backend (X-ResQ-Client-IP) for per-client rate limits.
INTERNAL_API_KEY=

# Optional GitHub OAuth app (both values needed to show "Continue with GitHub").
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Optional Google OAuth client (both values needed to show "Continue with Google").
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------------------------------
# Public build-time settings (visible to the browser)
# ---------------------------------------------------------------------------------------------

# Fallback map centre when the user's location is unknown (decimal degrees).
# Empty = New Delhi (28.6139, 77.2090).
NEXT_PUBLIC_DEFAULT_LAT=
NEXT_PUBLIC_DEFAULT_LON=

# "true" registers the service worker under `npm run dev` too (it is always registered in
# production builds). Useful for testing offline mode and push notifications locally.
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false
